# Copier en .env puis : set -a; source .env; set +a

# Lecteur local (crnn par défaut) et base de données locale
DAYONE_READER=crnn
DAYONE_DB=data/local/server.db

# --- WhatsApp Business Cloud API (Meta) : voir WHATSAPP.md, chemin 1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=dayone
# facultatif : clé secrète de l'app Meta, pour vérifier la signature des webhooks
WHATSAPP_APP_SECRET=
# facultatif : WhatsApp Business Account ID (page « Faites un essai »), pour vérifier l'abonnement du compte
WHATSAPP_WABA_ID=

# --- Bac à sable Twilio : voir WHATSAPP.md, chemin 2
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# adresse publique du tunnel (ngrok), nécessaire pour envoyer les recadrages avec Twilio
PUBLIC_BASE_URL=
